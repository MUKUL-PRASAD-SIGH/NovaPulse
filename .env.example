# AWS Credentials for Amazon Nova
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# Multi-Source News APIs
TAVILY_API_KEY=your_tavily_key_here
GNEWS_API_KEY=your_gnews_key_here

# Development Mode
USE_MOCK_PLANNER=false

# Per-IP fair-use limits (limits are optional; the pepper is required when enabled)
NOVA_RATE_LIMIT_ENABLED=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NOVA_RATE_LIMIT_PEPPER=
NOVA_COMMANDS_PER_MINUTE=10
NOVA_COMMANDS_PER_DAY=100
NOVA_MONITORS_PER_HOUR=2
NOVA_MONITORS_PER_DAY=4
NOVA_MAX_ACTIVE_MONITORS_PER_IP=1
NOVA_OTPS_PER_TEN_MINUTES=5
NOVA_OTPS_PER_DAY=20

# Enable only behind a trusted reverse proxy/CDN that replaces forwarded headers.
NOVA_TRUST_PROXY_HEADERS=false
